<section class="locations layout-shell" id="locais" aria-labelledby="locations-title">

      <h2 class="locations__title" id="locations-title" data-motion>Locais de Atendimento</h2>

      <!-- Presencial -->
      <div class="locations__presencial" data-motion-stagger>
        <h3 class="locations__sub-title" data-motion>Presencial</h3>
        <a
          class="locations__map motion-hover-scale"
          data-motion
          href="https://www.google.com/maps/place/Shopping+Icara%C3%AD/@-22.9066003,-43.1132357,17z/data=!3m1!4b1!4m6!3m5!1s0x9983e3cf58a855:0x9b5dc41cea7ae8c1!8m2!3d-22.9066053!4d-43.1106608!16s%2Fg%2F1s04fd7g7?entry=ttu"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Abrir localização da Clínica Le Derme no Google Maps"
        >
          <img
            src="/assets/Maps.png"
            alt="Mapa da localização da Clínica Le Derme no Shopping Icaraí, Niterói"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </a>
        <address class="locations__address" data-motion>
          <p class="locations__clinic-name">Clínica Le Derme</p>
          <p class="locations__clinic-address">
            Rua Ator Paulo Gustavo, 229 – Shopping Icaraí – sala 1601<br />
            Icaraí, Niterói – RJ
          </p>
        </address>
      </div>

      <!-- Domiciliar + Online -->
      <div class="locations__bottom" data-motion-stagger>

        <div class="locations__domiciliar" data-motion>
          <h3 class="locations__sub-title">Domiciliar</h3>
          <div class="locations__tags">
            <img
              class="locations__pin-icon"
              src="/assets/pin.svg"
              alt="Ícone de localização"
            />
            <span class="locations__tag">Niterói</span>
            <span class="locations__tag">Rio de Janeiro</span>
            <span class="locations__tag">São Gonçalo</span>
            <span class="locations__tag">Maricá</span>
          </div>
        </div>

        <div class="locations__online" data-motion>
          <h3 class="locations__online-title">Online</h3>
          <p class="locations__online-note">*Apenas para segunda opinião de laudo</p>
        </div>

      </div>

    </section>