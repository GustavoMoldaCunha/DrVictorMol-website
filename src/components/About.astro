---
import TestimonialsCarousel from './TestimonialsCarousel.astro';
---

<section class="about layout-shell" id="sobre" aria-labelledby="about-title">

      <div class="about__title-wrap" data-motion-stagger>
        <h2 class="about__title" id="about-title" data-motion>Sobre mim</h2>
        <div class="about__description-wrap" data-motion>
          <p class="about__description">
            Acredito que, por trás de cada imagem, existe uma história — a sua história. E é com respeito, escuta e dedicação que conduzo cada atendimento. Estou aqui para ajudar você a entender melhor o seu corpo, seu exame e, principalmente, suas opções.
          </p>
          <img
            class="about__logo-small"
            src="/assets/brand/LogoIconeDark.webp"
            alt=""
            aria-hidden="true"
          />
        </div>
      </div>

      <!-- Infographic -->
      <div class="about__infographic">

        <div class="about__doctor-stage" data-motion="subtle">
          <div class="about__doctor-photo">
            <img
              src="/assets/about/VictorSobre.webp"
              alt="Dr. Victor Mol em consultório"
              width="370"
              height="556"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="about__cards about__cards--left" data-motion-stagger>
        <!-- Formação card -->
        <article class="info-card info-card--formacao motion-hover-lift" data-motion aria-label="Formação">
          <img
            class="info-card--formacao__logo"
            src="/assets/about/FormaçãoUFFLogo.svg"
            alt="Logo Universidade Federal Fluminense"
          />
          <div class="info-card__text-block">
            <h3 class="info-card__heading">Formação</h3>
            <p class="info-card__body">
              Me formei em Medicina pela Universidade Federal Fluminense (UFF), onde também me especializei em Radiologia e Diagnóstico por Imagem.
            </p>
          </div>
        </article>

        <!-- Experiência card -->
        <article class="info-card info-card--experiencia motion-hover-lift" data-motion aria-label="Experiência">
          <div class="info-card--experiencia__number-block" aria-hidden="true">
            <img
              class="info-card--experiencia__graphic"
              src="/assets/about/10+ anos de carreira.svg"
              alt=""
              width="128"
              height="127"
            />
          </div>
          <div class="info-card__text-block">
            <h3 class="info-card__heading">Experiência</h3>
            <p class="info-card__body">
              Desenvolvi uma atuação centrada no paciente, traduzindo exames e imagens em informações claras, seguras e úteis para você e seu médico.
            </p>
          </div>
        </article>
        </div>

        <div class="about__cards about__cards--right" data-motion-stagger>
        <!-- Serviço acessível card -->
        <article class="info-card info-card--servico motion-hover-lift" data-motion aria-label="Serviço acessível">
          <div class="info-card--servico__image" aria-hidden="true">
            <img src="/assets/about/ServiçoAcessível.svg" alt="" />
          </div>
          <div class="info-card__text-block">
            <h3 class="info-card__heading">Serviço acessível</h3>
            <p class="info-card__body">
              Ultrassonografia domiciliar com conforto, segurança e equipamentos modernos, levando até você a mesma qualidade de um consultório.
            </p>
          </div>
        </article>

        <!-- Reconhecimento card -->
        <article class="info-card info-card--reconhecimento motion-hover-lift" data-motion aria-label="Reconhecimento">
          <img
            class="info-card--reconhecimento__logo"
            src="/assets/about/Reconhecimento.png"
            alt="Logo Colégio Brasileiro de Radiologia"
          />
          <div class="info-card__text-block">
            <h3 class="info-card__heading">Reconhecimento</h3>
            <p class="info-card__body">
              Sou membro titular do Colégio Brasileiro de Radiologia e atuo com foco em duas áreas: Neurorradiologia e Ultrassonografia Especializada.
            </p>
          </div>
        </article>
        </div>

        <div class="about__connectors" aria-hidden="true">
          <div class="about__connector about__connector--formacao">
            <svg class="about__connector__line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="1" x2="100" y2="1" stroke="#3E8FB0" stroke-width="1" />
            </svg>
            <div class="about__connector__dot">
              <img class="about__connector__dot-outer" src="/assets/about/Ellipse 7.svg" alt="" />
              <img class="about__connector__dot-inner" src="/assets/about/Ellipse 8.svg" alt="" />
            </div>
          </div>
          <div class="about__connector about__connector--experiencia">
            <svg class="about__connector__line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="1" x2="100" y2="1" stroke="#3E8FB0" stroke-width="1" />
            </svg>
            <div class="about__connector__dot">
              <img class="about__connector__dot-outer" src="/assets/about/Ellipse 7.svg" alt="" />
              <img class="about__connector__dot-inner" src="/assets/about/Ellipse 8.svg" alt="" />
            </div>
          </div>
          <div class="about__connector about__connector--servico">
            <div class="about__connector__dot">
              <img class="about__connector__dot-outer" src="/assets/about/Ellipse 7.svg" alt="" />
              <img class="about__connector__dot-inner" src="/assets/about/Ellipse 8.svg" alt="" />
            </div>
            <svg class="about__connector__line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="1" x2="100" y2="1" stroke="#3E8FB0" stroke-width="1" />
            </svg>
          </div>
          <div class="about__connector about__connector--reconhecimento">
            <div class="about__connector__dot">
              <img class="about__connector__dot-outer" src="/assets/about/Ellipse 7.svg" alt="" />
              <img class="about__connector__dot-inner" src="/assets/about/Ellipse 8.svg" alt="" />
            </div>
            <svg class="about__connector__line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="1" x2="100" y2="1" stroke="#3E8FB0" stroke-width="1" />
            </svg>
          </div>
        </div>

      </div>

      <!-- TESTIMONIALS -->
      <div class="testimonials" id="depoimentos" data-motion-stagger tabindex="0">
        <h2 class="testimonials__title" data-motion>O que os pacientes dizem</h2>
        <TestimonialsCarousel />

        <div class="testimonials__controls" data-motion>
          <img
            class="testimonials__profiles"
            src="/assets/about/Perfis.svg"
            alt="Fotos de pacientes"
            width="100"
            height="50"
          />

          <div class="testimonials__stars" aria-label="Avaliação 5 estrelas">
            <img src="/assets/about/star.svg" alt="" aria-hidden="true" />
            <img src="/assets/about/star.svg" alt="" aria-hidden="true" />
            <img src="/assets/about/star.svg" alt="" aria-hidden="true" />
            <img src="/assets/about/star.svg" alt="" aria-hidden="true" />
            <img src="/assets/about/star.svg" alt="" aria-hidden="true" />
          </div>

          <div class="testimonials__nav" role="group" aria-label="Navegação de depoimentos">
            <button
              class="testimonials__nav-btn motion-btn"
              type="button"
              data-testimonials-prev
              aria-label="Depoimento anterior"
            >
              <img src="/assets/about/Group 13.svg" alt="" aria-hidden="true" width="44" height="42" />
            </button>
            <button
              class="testimonials__nav-btn testimonials__nav-btn--next motion-btn"
              type="button"
              data-testimonials-next
              aria-label="Próximo depoimento"
            >
              <img src="/assets/about/Group 13.svg" alt="" aria-hidden="true" width="44" height="42" />
            </button>
          </div>
        </div>
      </div>

    </section>
