---
import WhatsAppCta from './WhatsAppCta.astro';
import DecorativeCircle from './DecorativeCircle.astro';
import { SERVICES as services } from '../data/services';
---

<section class="services layout-shell" id="servicos" aria-labelledby="services-title">

      <div class="services__header" data-motion-stagger>
        <h2 class="services__title" id="services-title" data-motion>Serviços</h2>
        <div class="services__description-wrap" data-motion>
          <p class="services__description">
            Nesta seção, você encontra os principais exames e avaliações por imagem que realizo. Meu trabalho é ajudar pacientes e médicos a entender melhor os resultados dos exames, oferecendo segurança, clareza e cuidado em cada atendimento.
          </p>
          <img
            class="services__logo-small"
            src="/assets/brand/LogoIconeDark.webp"
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            aria-hidden="true"
          />
        </div>
      </div>

      <div class="services__grid" data-motion-stagger>

        {services.map((service) => {
          const overlayClass = service.overlayLighter
            ? 'service-card__bg-overlay service-card__bg-overlay--lighter'
            : 'service-card__bg-overlay';
          const cardBg = (
            <>
              <div class="service-card__bg" aria-hidden="true">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  width="291"
                  height="257"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <div class={overlayClass}></div>
              </div>
              <div class="service-card__arrow-wrap">
                <img
                  class="service-card__arrow"
                  src="/assets/services/service-arrow.svg"
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  aria-hidden="true"
                />
              </div>
              <h3 class="service-card__title">{service.title}</h3>
            </>
          );

          return service.href ? (
            <a href={service.href} class="service-card" data-motion>
              {cardBg}
            </a>
          ) : (
            <article class="service-card" data-motion>
              {cardBg}
            </article>
          );
        })}

        <article class="service-card service-card--dark" data-motion>
          <div class="service-card__bg-pattern" aria-hidden="true">
            <DecorativeCircle />
          </div>
          <div class="service-card__inner">
            <div class="service-card__arrow-wrap">
              <img
                class="service-card__arrow"
                src="/assets/services/service-arrow.svg"
                alt=""
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                aria-hidden="true"
              />
            </div>
            <WhatsAppCta variant="contact" />
          </div>
        </article>

      </div>
    </section>
