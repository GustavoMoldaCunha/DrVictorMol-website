---
import DecorativeCircle from '../DecorativeCircle.astro';
import WhatsAppCta from '../WhatsAppCta.astro';

interface Props {
  title: string;
  text: string;
  buttonLabel?: string;
}

const {
  title,
  text,
  buttonLabel = 'Quero agendar uma consulta',
} = Astro.props;
---

<div class="service-final-cta-wrap layout-shell">
  <section class="service-final-cta" aria-labelledby="service-final-cta-title" data-motion>
    <div class="service-cta__pattern" aria-hidden="true">
      <DecorativeCircle />
    </div>
    <div class="service-final-cta__inner">
      <h2 class="service-final-cta__title" id="service-final-cta-title">{title}</h2>
      <p class="service-final-cta__text">{text}</p>
      <WhatsAppCta variant="hero" label={buttonLabel} />
    </div>
  </section>
</div>
