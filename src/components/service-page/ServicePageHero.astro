---
import DecorativeCircle from '../DecorativeCircle.astro';

interface Props {
  title: string;
  subtitle: string;
  breadcrumbCurrent: string;
  imageSrc?: string;
  imageAlt?: string;
  /** Extra class on the visual stage (e.g. square artwork framing). */
  mediaClass?: string;
}

const {
  title,
  subtitle,
  breadcrumbCurrent,
  imageSrc,
  imageAlt = '',
  mediaClass = '',
} = Astro.props;

const hasImage = Boolean(imageSrc);
---

<header class="service-hero-wrap header">
  <div class="service-hero layout-shell" aria-labelledby="service-hero-title">
    <div class="service-hero__bg" aria-hidden="true"></div>
    <div class="service-hero__bg-pattern" aria-hidden="true">
      <DecorativeCircle />
    </div>

    <div class="service-hero__body">
      <div class="service-hero__content" data-motion-immediate-stagger>
        <nav class="service-hero__breadcrumb" aria-label="Breadcrumb" data-motion>
          <ol>
            <li><a href="/">Início</a></li>
            <li class="service-hero__breadcrumb-sep" aria-hidden="true">/</li>
            <li><a href="/#servicos">Serviços</a></li>
            <li class="service-hero__breadcrumb-sep" aria-hidden="true">/</li>
            <li><span aria-current="page">{breadcrumbCurrent}</span></li>
          </ol>
        </nav>

        <h1 class="service-hero__title" id="service-hero-title" data-motion>{title}</h1>
        <p class="service-hero__subtitle" data-motion>{subtitle}</p>
      </div>

      {hasImage ? (
        <div
          class:list={['service-hero__stage', mediaClass]}
          data-motion-immediate
        >
          <div class="service-hero__decor-stage" aria-hidden="true">
            <div class="service-hero__decor">
              <DecorativeCircle />
            </div>
          </div>
          <div class="service-hero__image">
            <img
              class="service-hero__img"
              src={imageSrc}
              alt={imageAlt}
              width="360"
              height="270"
              sizes="(max-width: 900px) 100vw, 460px"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      ) : (
        <div class="service-hero__stage service-hero__stage--placeholder" aria-hidden="true"></div>
      )}
    </div>
  </div>
</header>
