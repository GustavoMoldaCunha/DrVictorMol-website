---
import DecorativeCircle from '../DecorativeCircle.astro';
import WhatsAppCta from '../WhatsAppCta.astro';

interface Props {
  text: string;
  buttonLabel?: string;
}

const { text, buttonLabel = 'Quero agendar uma consulta' } = Astro.props;
---

<aside class="service-inline-cta" data-motion aria-label="Agendar consulta">
  <div class="service-cta__pattern" aria-hidden="true">
    <DecorativeCircle />
  </div>
  <div class="service-inline-cta__inner">
  <p class="service-inline-cta__text">{text}</p>
  <WhatsAppCta variant="hero" label={buttonLabel} />
  </div>
</aside>
